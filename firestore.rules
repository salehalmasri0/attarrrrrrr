rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================================================
       ملاحظة مهمة جدًا — اقرأها قبل النشر الفعلي:
       =========================================================
       هذا التطبيق واجهة أمامية بالكامل (Frontend-only) ولا يستخدم
       Firebase Authentication — "تسجيل الدخول" يتم بالتحقق من بيانات
       داخل مستند Firestore، وليس عبر نظام مصادقة حقيقي.
       نتيجة ذلك: لا يمكن كتابة قواعد "كل مستخدم يرى بياناته فقط" بمعناها
       الصحيح، لأن Firestore لا "يعرف" من هو المستخدم المسجّل حاليًا.

       القواعد أدناه تسمح بالقراءة/الكتابة لأي طلب يصل فعليًا إلى مشروعك
       (نفس السلوك الافتراضي إن لم تكن قد أضفت ملف قواعد من قبل). هذا لا
       يعني أن أي شخص على الإنترنت يستطيع الوصول بسهولة — فهو يحتاج معرفة
       معرّف مشروعك (projectId) تحديدًا — لكنه لا يمنع شخصًا تقنيًا اطّلع
       على كود الموقع (العام على GitHub) من الوصول المباشر لقاعدة البيانات
       متجاوزًا واجهة تسجيل الدخول تمامًا.

       للحصول على أمان حقيقي، اختر أحد الخيارين (موصى به بشدة):
       1) الأسهل: فعّل "App Check" من Firebase Console (Build → App Check)
          باستخدام reCAPTCHA v3، ثم فعّل "Enforce" على Firestore. هذا يمنع
          أي طلب لا يأتِ من نسخة موقعك الفعلية، حتى بدون تسجيل دخول حقيقي.
       2) الأشمل: رحّل تسجيل الدخول إلى Firebase Authentication (مثال:
          Custom Token يُصدره Cloud Function بعد التحقق من PIN/كلمة المرور)
          ثم استخدم request.auth لكتابة قواعد دقيقة لكل دور (admin/coordinator).

       راجع README.md → قسم "الأمان وقواعد Firestore" لشرح الخطوات كاملة. */

    match /app/core {
      allow read, write: if true; // TODO: قيّده بعد تفعيل App Check أو Firebase Authentication
    }

    match /visits/{visitId} {
      allow read, write: if true; // TODO: قيّده بعد تفعيل App Check أو Firebase Authentication
    }

    // أي مسار آخر غير مذكور أعلاه: مرفوض بالكامل افتراضيًا
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
